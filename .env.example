# Application environment: development, testing, or production
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
# APP_LOG_DIR=/absolute/path/to/application-logs
APP_APP_NAME="Miselium"
APP_APP_VERSION=0.8.0

# Configure when the FastAPI service is available, for example:
# APP_API_BASE_URL=http://127.0.0.1:8000

# Backend configuration (never commit real secrets)
# MISELIUM_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/miselium
# MISELIUM_JWT_SECRET=replace-with-at-least-32-random-characters
MISELIUM_ENVIRONMENT=development
